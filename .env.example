APP_NAME=LabSIS-KIT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
WWWUSER=1000
WWWGROUP=1000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=labsis
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

GITHUB_REPOSITORY="https://github.com/iurygdeoliveira/labSIS-KIT"
EDITOR="antigravity"

FILAMENT_SECURITY_DISPOSABLE_EMAIL=true
FILAMENT_SECURITY_HONEYPOT=true
FILAMENT_SECURITY_CLOUDFLARE=false
FILAMENT_SECURITY_EVENT_LOG=true
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VOTING_OPENS_AT=2026-11-24T20:00:00-03:00
VOTING_CLOSES_AT=2026-11-26T12:00:00-03:00
VOTING_IP_KEY=
VOTING_GOOGLE_REQUESTS_PER_IP_PER_MINUTE=1500
VOTING_VOTE_ATTEMPTS_PER_IP_PER_MINUTE=1500
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/votacao/google/callback
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
